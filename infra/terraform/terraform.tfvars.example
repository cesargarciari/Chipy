# cp terraform.tfvars.example terraform.tfvars  (gitignored)

project     = "chipy"
environment = "prod"
aws_region  = "ca-central-1"

# Custom domain. Leave all three empty to serve on the free *.cloudfront.net domain.
domain_name = "" # e.g. "chipy.gg" or "chipy.example.dev"

# Pick ONE of the two paths below for the domain, or leave both empty.

# Path A - DNS lives in Route 53. Leave route53_zone_id empty to let Terraform
# create the hosted zone (then set its nameservers at your registrar).
route53_zone_id = ""

# Path B - DNS lives elsewhere (Cloudflare, etc.). Validate a cert there instead
# (see infra/terraform/README.md "Custom domain: DNS hosted outside Route 53")
# and paste its ARN here. When this is set, route53_zone_id above is ignored.
acm_certificate_arn = ""

# Guardrails.
monthly_budget_usd = 5
alert_email         = "" # e.g. "you@example.com" for budget + alarm mail

# Hard cap on concurrent API executions. 0 = unmanaged (required if `apply`
# fails with "decreases account's UnreservedConcurrentExecution below its
# minimum value" - your account's regional Lambda quota is still the low
# new-account default; check with `aws lambda get-account-settings --region
# <your region>`). Once that quota is raised, set a positive number to restore
# the cap.
lambda_reserved_concurrency = 5

# Set to false only when you actually want `terraform destroy` to work.
deletion_protection       = true
site_bucket_force_destroy = false
