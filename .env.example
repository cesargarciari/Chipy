# Copy to .env for local development: cp .env.example .env
# docker-compose and the dev scripts read these.

# ---- API ----
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=debug
# Comma-separated origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# ---- DynamoDB ----
# Single-table name (same in local + AWS).
DYNAMODB_TABLE=chipy
# Local endpoint. Leave BLANK when running against real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ca-central-1
# DynamoDB Local ignores these but the SDK requires them to be set.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- Web (Vite; must be prefixed VITE_) ----
VITE_API_URL=http://localhost:3000
