{
  "name": "@chipy/api",
  "version": "0.4.19",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "tsx scripts/create-table.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "@chipy/engine": "workspace:*",
    "@chipy/shared": "workspace:*",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
